DATABASE_URL=postgresql+psycopg://applymatch:change-me@localhost:5433/applymatch
LBA_API_KEY=
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=10080
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
CORS_ORIGINS=http://localhost:3000

COLLECTOR_SCHEDULER_ENABLED=false
COLLECTOR_INTERVAL_MINUTES=15
COLLECTOR_RUN_ON_STARTUP=false

# Entreprises a exclure completement des collecteurs Greenhouse/Lever/
# SmartRecruiters (liste separee par des virgules, insensible a la casse).
# Ex: COLLECTOR_COMPANY_BLOCKLIST=theodo,autre-entreprise
COLLECTOR_COMPANY_BLOCKLIST=

AI_TEXT_GENERATION_ENABLED=false
AI_API_URL=
AI_API_KEY=
AI_MODEL=
PDF_ENGINE=reportlab
GENERATED_DOCUMENTS_DIR=

# Optional background workers. Keep false until Redis is running.
BACKGROUND_TASKS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
BACKGROUND_LOCK_SECONDS=900

# Observability (disabled when DSN values are empty)
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0

# Gmail OAuth 2.0 (never commit the real client secret or token file)
GMAIL_CLIENT_SECRET_FILE=secrets/google-oauth-client.json
GMAIL_TOKEN_FILE=secrets/gmail-token.json
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8765/
